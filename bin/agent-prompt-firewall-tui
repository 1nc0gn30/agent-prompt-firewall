#!/usr/bin/env python3
"""Agent Prompt Firewall v2.6.0 — Live Threat Radar TUI.
Polls live loopback daemon (127.0.0.1:8098) or falls back to local SQLite WAL telemetry.
Zero fabricated metrics. Zero external dependencies.
Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform
"""
import argparse
import json
import os
import sys
import time
import urllib.request

VERSION = "2.6.0"


def _resolve_repo_src() -> str:
    for cand in (
        os.environ.get("AGENT_PROMPT_FIREWALL_HOME", ""),
        "/opt/agent-prompt-firewall",
        os.path.expanduser("~/NullAITech/agent-prompt-firewall"),
        os.path.abspath(os.path.join(os.path.dirname(os.path.realpath(__file__)), "..")),
    ):
        src = os.path.join(cand, "src")
        if cand and os.path.isdir(os.path.join(src, "agent_prompt_firewall")):
            return src
    return ""


def _fetch_json(url: str, timeout: float = 1.5):
    try:
        with urllib.request.urlopen(url, timeout=timeout) as resp:
            if resp.status == 200:
                return json.loads(resp.read().decode("utf-8"))
    except Exception:
        return None
    return None


def collect_snapshot(port: int, db_path: str) -> dict:
    health = _fetch_json(f"http://127.0.0.1:{port}/health")
    stats = _fetch_json(f"http://127.0.0.1:{port}/api/stats")
    scans = _fetch_json(f"http://127.0.0.1:{port}/api/scans?limit=8")
    threats = _fetch_json(f"http://127.0.0.1:{port}/api/threats?limit=5")
    source = f"live_daemon:{port}" if health is not None else "local_sqlite"

    chain_info = None
    if stats is None or scans is None:
        if db_path and os.path.exists(db_path):
            src = _resolve_repo_src()
            if src and src not in sys.path:
                sys.path.insert(0, src)
            try:
                from agent_prompt_firewall.storage import FirewallStorage
                store = FirewallStorage(db_path=db_path)
                stats = stats or store.get_stats()
                scans = scans if scans is not None else store.get_recent_scans(limit=8)
                threats = threats if threats is not None else store.get_recent_threats(limit=5)
                chain_info = store.verify_chain()
            except Exception:
                pass
        stats = stats or {"total_scans": 0, "total_blocked": 0, "total_redactions": 0, "clean_rate": 100.0, "avg_latency_ms": 0.0}
        scans = scans or []
        threats = threats or []

    return {
        "tool": "agent-prompt-firewall",
        "version": VERSION,
        "author": "Neal Frazier Tech (@1nc0gn30) • NullAI Platform",
        "source": source,
        "daemon_live": health is not None,
        "web_port": (health or {}).get("web_port", port),
        "proxy_port": (health or {}).get("proxy_port", 8198),
        "stats": stats,
        "chain_verification": chain_info,
        "recent_scans": scans or [],
        "recent_threats": threats or [],
    }


def render_frame(snap: dict) -> str:
    stats = snap["stats"]
    status = "ONLINE" if snap["daemon_live"] else "LOCAL DB"
    lines = [
        "\033[1;33m╭────────────────────────────────────────────────────────────────────────────╮\033[0m",
        f"\033[1;33m│\033[0m 🛡  \033[1;37mAgent Prompt Firewall v{VERSION} — Live Threat Radar TUI\033[0m    [{status:<8}] \033[1;33m│\033[0m",
        f"\033[1;33m│\033[0m Radar: http://127.0.0.1:{snap['web_port']:<5}  Proxy: http://127.0.0.1:{snap['proxy_port']:<5}  Source: {snap['source']:<16}\033[1;33m│\033[0m",
        "\033[1;33m├────────────────────────────────────────────────────────────────────────────┤\033[0m",
        (
            f"\033[1;33m│\033[0m Scans: \033[1;37m{stats.get('total_scans', 0):<6}\033[0m  "
            f"Blocked: \033[1;31m{stats.get('total_blocked', 0):<6}\033[0m  "
            f"Redacted: \033[1;33m{stats.get('total_redactions', 0):<6}\033[0m  "
            f"Clean: \033[1;32m{stats.get('clean_rate', 100.0):>5.1f}%\033[0m   \033[1;33m│\033[0m"
        ),
        "\033[1;33m├────────────────────────────────────────────────────────────────────────────┤\033[0m",
        "\033[1;33m│\033[0m Recent Pre-Redacted Scans:                                                 \033[1;33m│\033[0m",
    ]
    scans = snap.get("recent_scans") or []
    if not scans:
        lines.append("\033[1;33m│\033[0m   (No scans recorded yet. Route traffic via :8198 or POST /api/scan.)     \033[1;33m│\033[0m")
    else:
        for s in scans[:6]:
            verdict = "BLOCK" if s.get("blocked") else "PASS "
            color = "\033[31m" if s.get("blocked") else "\033[32m"
            snippet = str(s.get("prompt_snippet") or "").replace("\n", " ")[:44]
            score = float(s.get("threat_score", 0.0))
            lines.append(
                f"\033[1;33m│\033[0m {color}{verdict}\033[0m {score:0.2f} [{str(s.get('threat_type', 'CLEAN')):<8}] {snippet:<49} \033[1;33m│\033[0m"
            )
    lines.append("\033[1;33m├────────────────────────────────────────────────────────────────────────────┤\033[0m")
    lines.append("\033[1;33m│\033[0m Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform              \033[1;33m│\033[0m")
    lines.append("\033[1;33m╰────────────────────────────────────────────────────────────────────────────╯\033[0m")
    return "\n".join(lines)


def main():
    ap = argparse.ArgumentParser(
        prog="agent-prompt-firewall-tui",
        description=f"Agent Prompt Firewall v{VERSION} Live Threat Radar TUI",
    )
    ap.add_argument("--version", action="version", version=f"agent-prompt-firewall-tui v{VERSION}")
    ap.add_argument("--port", type=int, default=8098, help="Web Radar loopback port (default: 8098)")
    ap.add_argument("--db", default="firewall.db", help="SQLite database fallback path")
    ap.add_argument("--status", action="store_true", help="Print a single live telemetry snapshot and exit")
    ap.add_argument("--once", action="store_true", help="Alias for --status (single snapshot)")
    ap.add_argument("--json", action="store_true", help="Output live JSON snapshot and exit")
    ap.add_argument("--interval", type=float, default=1.5, help="Refresh interval in seconds (interactive mode)")
    args, _unknown = ap.parse_known_args()

    snap = collect_snapshot(port=args.port, db_path=args.db)
    if args.json:
        print(json.dumps(snap, indent=2))
        return
    if args.status or args.once or not sys.stdout.isatty():
        print(render_frame(snap))
        return

    try:
        while True:
            snap = collect_snapshot(port=args.port, db_path=args.db)
            sys.stdout.write("\033[2J\033[H" + render_frame(snap) + "\nPress Ctrl+C to exit.\n")
            sys.stdout.flush()
            time.sleep(max(0.5, args.interval))
    except KeyboardInterrupt:
        print("\nExited Threat Radar TUI.")


if __name__ == "__main__":
    main()
